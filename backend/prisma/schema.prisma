generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum OnlineOrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  DRIVER_ASSIGNED
  DRIVER_TO_RESTAURANT
  DRIVER_ARRIVED
  PICKED_UP
  OUT_FOR_DELIVERY
  DRIVER_NEARBY
  DELIVERED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationCategory {
  ORDERS
  REWARDS
  COUPONS
  MARKETING
  SUPPORT
  PAYMENTS
  SYSTEM
}

enum DeliveryAgentStatus {
  OFFLINE
  ONLINE
  BUSY
  DELIVERING
  TAKING_BREAK
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  CANCELLED
}

enum PromotionStatus {
  PENDING
  APPROVED
  REJECTED
  PAUSED
}

enum PromotionPlacement {
  PORTAL_HOME
  MENU_TOP
  CATEGORY
}

enum MenuCategoryKind {
  FOOD
  DRINK
  OTHER
}

enum MarketingItemType {
  CAMPAIGN
  DAILY_REWARD
  SPIN_WHEEL
  FLASH_DEAL
  COUPON
  REFERRAL_PROGRAM
  LOYALTY_PROGRAM
  DAILY_STREAK
  FEATURED_RESTAURANT
  HOMEPAGE_BANNER
  PUSH_NOTIFICATION
  CHALLENGE
  ANNOUNCEMENT
}

enum MarketingItemStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

enum DebtorStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  sales        Sale[]
  expenses     Expense[]
  debtors      Debtor[]
  marketingItems MarketingItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model MarketingItem {
  id          String              @id @default(cuid())
  type        MarketingItemType
  status      MarketingItemStatus @default(DRAFT)
  title       String
  description String?
  imageUrl    String?
  ctaLabel    String?
  deepLink    String?
  audience    String?
  startsAt    DateTime?
  endsAt      DateTime?
  priority    Int                 @default(0)
  config      Json                @default("{}")
  metrics     Json                @default("{}")
  createdById String?
  createdBy   User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  rewardClaims CustomerRewardClaim[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([type])
  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@index([priority])
}

model Customer {
  id              String        @id @default(cuid())
  name            String
  phone           String        @unique
  email           String?
  address         String?
  profileImageUrl String?
  points          Int           @default(0)
  referralCode    String        @unique
  referredById    String?
  referredBy      Customer?     @relation("CustomerReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals       Customer[]    @relation("CustomerReferrals")
  onlineOrders    OnlineOrder[]
  rewardClaims    CustomerRewardClaim[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([referredById])
}

model CustomerRewardClaim {
  id              String        @id @default(cuid())
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  marketingItemId String
  marketingItem   MarketingItem @relation(fields: [marketingItemId], references: [id], onDelete: Cascade)
  claimDate       DateTime
  points          Int           @default(0)
  streakCount     Int           @default(1)
  createdAt       DateTime      @default(now())

  @@unique([customerId, marketingItemId, claimDate])
  @@index([customerId, claimDate])
  @@index([marketingItemId])
}

model MenuCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  kind        MenuCategoryKind @default(FOOD)
  menuItems   MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MenuItem {
  id                String             @id @default(cuid())
  name              String
  description       String?
  price             Decimal            @db.Decimal(10, 2)
  variations        Json               @default("[]")
  imageUrl          String?
  isAvailable       Boolean            @default(true)
  categoryId        String
  category          MenuCategory       @relation(fields: [categoryId], references: [id])
  recipeIngredients RecipeIngredient[]
  saleItems         SaleItem[]
  onlineOrderItems  OnlineOrderItem[]
  reviews           MealReview[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model MealReview {
  id            String   @id @default(cuid())
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String?
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([menuItemId])
  @@index([rating])
}

model Ingredient {
  id                String             @id @default(cuid())
  name              String             @unique
  unit              String
  recipeIngredients RecipeIngredient[]
  stockItem         StockItem?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Supplier {
  id          String      @id @default(cuid())
  name        String
  phone       String?
  email       String?
  address     String?
  stockItems  StockItem[]
  expenses    Expense[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model StockItem {
  id            String          @id @default(cuid())
  name          String
  unit          String
  quantity      Decimal         @default(0) @db.Decimal(12, 3)
  reorderLevel  Decimal         @default(0) @db.Decimal(12, 3)
  unitCost      Decimal         @default(0) @db.Decimal(10, 2)
  ingredientId  String?         @unique
  ingredient    Ingredient?     @relation(fields: [ingredientId], references: [id])
  supplierId    String?
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  movements     StockMovement[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model StockMovement {
  id          String            @id @default(cuid())
  stockItemId String
  stockItem   StockItem         @relation(fields: [stockItemId], references: [id])
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3)
  note        String?
  createdAt   DateTime          @default(now())
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Decimal    @db.Decimal(12, 3)

  @@unique([menuItemId, ingredientId])
}

model Sale {
  id        String     @id @default(cuid())
  orderNo   String     @unique
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  status    SaleStatus @default(COMPLETED)
  subtotal  Decimal    @db.Decimal(10, 2)
  tax       Decimal    @default(0) @db.Decimal(10, 2)
  discount  Decimal    @default(0) @db.Decimal(10, 2)
  total     Decimal    @db.Decimal(10, 2)
  saleItems SaleItem[]
  payments  Payment[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model SaleItem {
  id         String   @id @default(cuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  total      Decimal  @db.Decimal(10, 2)
}

model OnlineOrder {
  id              String            @id @default(cuid())
  orderNo         String            @unique
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String
  customerPhone   String
  customerEmail   String?
  deliveryAddress String
  deliveryNote    String?
  isGift          Boolean           @default(false)
  recipientName   String?
  recipientPhone  String?
  recipientAddress String?
  latitude        Decimal?          @db.Decimal(10, 7)
  longitude       Decimal?          @db.Decimal(10, 7)
  status          OnlineOrderStatus @default(PENDING)
  deliveryAgentId String?
  deliveryAgent   DeliveryAgent?    @relation(fields: [deliveryAgentId], references: [id], onDelete: SetNull)
  driverName      String?
  driverPhone     String?
  driverPhotoUrl  String?
  vehicleInfo     String?
  driverLatitude  Decimal?          @db.Decimal(10, 7)
  driverLongitude Decimal?          @db.Decimal(10, 7)
  driverHeading   Decimal?          @db.Decimal(6, 2)
  driverSpeedKph  Decimal?          @db.Decimal(8, 2)
  trackingUpdatedAt DateTime?
  etaMinutes      Int?
  distanceKm      Decimal?          @db.Decimal(8, 2)
  driverAcceptedAt DateTime?
  driverDeliveredAt DateTime?
  driverCommission Decimal?         @db.Decimal(10, 2)
  subtotal        Decimal           @db.Decimal(10, 2)
  deliveryFee     Decimal           @default(0) @db.Decimal(10, 2)
  total           Decimal           @db.Decimal(10, 2)
  items           OnlineOrderItem[]
  trackingEvents  DeliveryTrackingEvent[]
  notifications   Notification[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([customerId])
  @@index([customerPhone])
  @@index([deliveryAgentId])
}

model DeliveryAgent {
  id             String              @id @default(cuid())
  code           String              @unique
  name           String
  phone          String?
  photoUrl       String?
  vehicleInfo    String?
  status         DeliveryAgentStatus @default(OFFLINE)
  latitude       Decimal?            @db.Decimal(10, 7)
  longitude      Decimal?            @db.Decimal(10, 7)
  heading        Decimal?            @db.Decimal(6, 2)
  speedKph       Decimal?            @db.Decimal(8, 2)
  lastSeenAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  orders         OnlineOrder[]

  @@index([name])
  @@index([status])
}

model DeliveryTrackingEvent {
  id              String            @id @default(cuid())
  onlineOrderId   String
  onlineOrder     OnlineOrder       @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  status          OnlineOrderStatus
  title           String
  message         String?
  latitude        Decimal?          @db.Decimal(10, 7)
  longitude       Decimal?          @db.Decimal(10, 7)
  etaMinutes      Int?
  distanceKm      Decimal?          @db.Decimal(8, 2)
  metadata        Json              @default("{}")
  createdAt       DateTime          @default(now())

  @@index([onlineOrderId, createdAt])
  @@index([status])
}

model Notification {
  id              String               @id @default(cuid())
  onlineOrderId   String?
  onlineOrder     OnlineOrder?         @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  customerId      String?
  category        NotificationCategory @default(SYSTEM)
  channel         NotificationChannel  @default(IN_APP)
  title           String
  body            String
  deepLink        String?
  readAt          DateTime?
  deliveredAt     DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  dismissedAt     DateTime?
  metadata        Json                 @default("{}")
  createdAt       DateTime             @default(now())

  @@index([customerId, readAt])
  @@index([onlineOrderId])
  @@index([category])
  @@index([createdAt])
}

model OnlineOrderItem {
  id            String      @id @default(cuid())
  onlineOrderId String
  onlineOrder   OnlineOrder @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem    @relation(fields: [menuItemId], references: [id])
  variationName String?
  quantity      Int
  unitPrice     Decimal     @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)
}

model Reservation {
  id            String            @id @default(cuid())
  reservationNo String            @unique
  customerName  String
  customerPhone String
  customerEmail String?
  partySize     Int
  mealPreference String?
  reservationAt DateTime
  status        ReservationStatus @default(PENDING)
  note          String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Promotion {
  id            String             @id @default(cuid())
  businessName  String
  contactName   String
  contactPhone  String
  contactEmail  String?
  title         String
  description   String
  imageUrl      String?
  ctaLabel      String             @default("Contact our Team")
  ctaUrl        String?
  placement     PromotionPlacement @default(PORTAL_HOME)
  status        PromotionStatus    @default(PENDING)
  adminNote     String?
  startsAt      DateTime?
  endsAt        DateTime?
  approvedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, placement])
  @@index([startsAt, endsAt])
}

model FlashSaleCode {
  id             String   @id @default(cuid())
  code           String   @unique
  title          String
  description    String?
  discountPercent Int     @default(10)
  isActive       Boolean  @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  maxRedemptions Int?
  redeemedCount  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
}

model AppSettings {
  id             String   @id @default("default")
  restaurantName String   @default("ChopASAP")
  shortName      String   @default("ChopASAP")
  currency       String   @default("XAF")
  deliveryFee    Decimal  @default(1000) @db.Decimal(10, 2)
  publicOrdering Boolean  @default(true)
  reservations   Boolean  @default(true)
  supportPhone   String   @default("+237671286999")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  reference String?
  createdAt DateTime      @default(now())
}

model ExpenseCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Expense {
  id          String          @id @default(cuid())
  title       String
  amount      Decimal         @db.Decimal(10, 2)
  note        String?
  receiptUrl  String?
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  supplierId  String?
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  expenseDate DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Debtor {
  id          String       @id @default(cuid())
  customerName String
  phone       String?
  description String
  amount      Decimal      @db.Decimal(10, 2)
  amountPaid  Decimal      @default(0) @db.Decimal(10, 2)
  status      DebtorStatus @default(OPEN)
  dueDate     DateTime?
  recordedById String
  recordedBy User          @relation(fields: [recordedById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([phone])
}
